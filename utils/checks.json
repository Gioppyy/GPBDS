{
  "lua_rce_chain": {
    "score": 9,
    "severity": "CRITICAL",
    "patterns": [
      "loadstring\\s*\\([^)]*(http|PerformHttpRequest|base64|decode)",
      "assert\\s*\\(\\s*load\\s*\\([^)]*(http|base64)",
      "_G\\s*\\[\\s*[\"']load[\"']\\s*\\]\\s*\\("
    ]
  },

  "lua_dynamic_exec_suspicious": {
    "score": 6,
    "severity": "HIGH",
    "patterns": [
      "\\bloadstring\\s*\\(",
      "\\bload\\s*\\(",
      "getfenv\\s*\\(",
      "setfenv\\s*\\("
    ]
  },

  "js_eval_chain": {
    "score": 9,
    "severity": "CRITICAL",
    "patterns": [
      "eval\\s*\\(\\s*(atob|decodeURIComponent|String\\.fromCharCode)",
      "new\\s+Function\\s*\\([^)]*(return|atob|decode)",
      "setTimeout\\s*\\(\\s*['\"][^'\"]{20,}['\"]"
    ]
  },

  "js_obfuscation_medium": {
    "score": 4,
    "severity": "MEDIUM",
    "patterns": [
      "String\\.fromCharCode\\s*\\(",
      "atob\\s*\\(",
      "btoa\\s*\\(",
      "\\\\x[0-9a-fA-F]{2}",
      "\\\\u[0-9a-fA-F]{4}"
    ]
  },

  "network_event_suspicious": {
    "score": 8,
    "severity": "HIGH",
    "patterns": [
      "RegisterNetEvent\\s*\\([^)]*(admin|backdoor|inject)",
      "TriggerServerEvent\\s*\\([^)]*(execute|eval|load)"
    ]
  },

  "http_remote_exec": {
    "score": 8,
    "severity": "HIGH",
    "patterns": [
      "PerformHttpRequest\\s*\\([^)]*(load|string|assert)",
      "https?:\\/\\/[^\\s\"']+\\.(lua|txt|dat)\\b"
    ]
  },

  "command_execution": {
    "score": 9,
    "severity": "CRITICAL",
    "patterns": [
      "os\\.execute\\s*\\(",
      "io\\.popen\\s*\\(",
      "os\\.popen\\s*\\("
    ]
  },

  "command_exec_with_payload": {
    "score": 10,
    "severity": "CRITICAL",
    "patterns": [
      "os\\.execute\\s*\\([^)]*(curl|wget|bash|sh)",
      "io\\.popen\\s*\\([^)]*(curl|wget)"
    ]
  },

  "filesystem_suspicious": {
    "score": 4,
    "severity": "MEDIUM",
    "patterns": [
      "io\\.open\\s*\\(",
      "os\\.remove\\s*\\(",
      "os\\.rename\\s*\\("
    ]
  },

  "credential_exfiltration": {
    "score": 8,
    "severity": "HIGH",
    "patterns": [
      "Authorization:\\s*Bearer",
      "mysql://"
    ]
  },

  "data_exfiltration": {
    "score": 7,
    "severity": "HIGH",
    "patterns": [
      "PerformHttpRequest\\s*\\([^)]*(ipify|webhook)",
      "https?:\\/\\/api\\.ipify\\.org"
    ]
  },

  "resource_infection": {
    "score": 8,
    "severity": "HIGH",
    "patterns": [
      "GetNumResources\\s*\\(",
      "GetResourcePath\\s*\\(",
      "installBackdoorToScripts"
    ]
  },

  "obfuscation_heavy": {
    "score": 6,
    "severity": "HIGH",
    "patterns": [
      "(\\\\x[0-9a-fA-F]{2}){10,}",
      "string\\.char\\s*\\(",
      "string\\.reverse\\s*\\("
    ]
  },

  "hex_obfuscation": {
    "score": 3,
    "severity": "LOW",
    "patterns": [
      "'[0-9a-fA-F]{2}'\\s*,\\s*'[0-9a-fA-F]{2}'"
    ]
  }
}
